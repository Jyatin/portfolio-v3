# RAG embeddings
OPENAI_API_KEY=your_openai_api_key
RAG_EMBEDDING_MODEL=text-embedding-3-small

# RAG generation
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-5

# Distributed rate limiting for Vercel/serverless
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
RATE_LIMIT_SALT=replace_with_a_long_random_secret

# Existing Supabase variables, if your owner inbox still uses Supabase:
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Contact & Message Delivery (Resend.com)
# Obtain a free API key at https://resend.com
RESEND_API_KEY=your_resend_api_key
# Optional custom sender address (defaults to "Portfolio Contact <onboarding@resend.dev>")
# RESEND_FROM="Jyatin Kumar Singh <contact@yourdomain.com>"
# Recipient email address (defaults to singhjyatin@gmail.com)
CONTACT_EMAIL=singhjyatin@gmail.com
